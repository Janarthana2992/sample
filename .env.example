# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ecom_db

# ─── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ─── Elasticsearch ────────────────────────────────────────
ELASTIC_PASSWORD=change_me_elastic_password

# ─── JWT ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
INTERNAL_SERVICE_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64

# ─── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ─── Frontend ─────────────────────────────────────────────
# With Nginx reverse proxy (recommended): use relative paths
FRONTEND_URL=http://localhost
VITE_AUTH_SERVICE_URL=/api/auth
VITE_PRODUCT_SERVICE_URL=/api/products
VITE_CART_SERVICE_URL=/api/cart
VITE_ORDER_SERVICE_URL=/api/orders
VITE_AI_SERVICE_URL=/api/ai

# Without reverse proxy (direct access): use absolute URLs
# VITE_AUTH_SERVICE_URL=http://localhost:8001
# VITE_PRODUCT_SERVICE_URL=http://localhost:8002
# VITE_CART_SERVICE_URL=http://localhost:8003
# VITE_ORDER_SERVICE_URL=http://localhost:8004
# VITE_AI_SERVICE_URL=http://localhost:8005

# ─── Google Maps ──────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── Gemini AI (optional fallback for search intent parsing) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Groq AI (no longer required — local LLM is used) ────
# Kept for backward compatibility; ignored if local LLM loads
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ─── Environment ──────────────────────────────────────────
ENVIRONMENT=development
