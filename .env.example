# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ecom_db

# ─── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ─── Elasticsearch ────────────────────────────────────────
ELASTIC_PASSWORD=change_me_elastic_password

# ─── JWT ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
INTERNAL_SERVICE_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64

# ─── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_AUTH_SERVICE_URL=http://localhost:8001
VITE_PRODUCT_SERVICE_URL=http://localhost:8002
VITE_CART_SERVICE_URL=http://localhost:8003
VITE_ORDER_SERVICE_URL=http://localhost:8004
VITE_AI_SERVICE_URL=http://localhost:8005

# ─── Mapbox ───────────────────────────────────────────────
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# ─── Environment ──────────────────────────────────────────
ENVIRONMENT=development
